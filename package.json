{
  "name": "blunow-monorepo",
  "private": true,
  "workspaces": [
    "apps/backend",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "npm run dev:admin",
    "dev:all": "turbo run dev",
    "dev:backend": "turbo run dev --filter=@blunow/backend",
    "dev:admin": "npm run dev --prefix apps/admin",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "turbo": "^2.1.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "npm@10.8.0"
}
