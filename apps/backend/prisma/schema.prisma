// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  OTHER
}

enum Sexuality {
  STRAIGHT
  GAY
  LESBIAN
  BI
  ASEXUAL
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  GIF
}

enum RoomType {
  PUBLIC
  PRIVATE
  TOPIC
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum NotificationType {
  MATCH
  MESSAGE
  LIKE
  COMMENT
  STORY_VIEW
  CONFESSION
  ROOM_INVITE
  SYSTEM
}

enum BanType {
  TEMPORARY
  PERMANENT
}

enum BanStatus {
  NONE
  WARNED
  TEMP_BANNED
  PERM_BANNED
}

enum ReportStatus {
  PENDING
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
  ESCALATED
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE_CONTENT
  FAKE_PROFILE
  HATE_SPEECH
  OTHER
}

enum ContentType {
  POST
  STORY
  MESSAGE
  CONFESSION
  USER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AutoFlagType {
  NUDITY
  VIOLENCE
  TOXICITY
  SPAM
  EXPLICIT
}

enum AutoAction {
  HOLD_FOR_REVIEW
  AUTO_REMOVE
}

enum ReportResolution {
  APPROVED
  REJECTED
  DISMISSED
}

enum FlagStatus {
  QUEUED_FOR_REVIEW
  AUTO_REMOVED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String?
  googleId        String?  @unique
  role            Role     @default(USER)
  isActive        Boolean  @default(true)
  isVerified      Boolean  @default(false)
  strikeCount     Int      @default(0)
  banStatus       BanStatus @default(NONE)
  banExpiresAt    DateTime?
  fcmToken        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  sexuality       Sexuality @default(STRAIGHT)

  profile         Profile?
  stats           UserStat?
  verification    UserVerification?
  
  followers       UserFollow[] @relation("UserFollowers")
  following       UserFollow[] @relation("UserFollowing")
  
  sentRequests    MatchRequest[]   @relation("SentRequests")
  receivedRequests MatchRequest[]  @relation("ReceivedRequests")
  matchesAsUser1  Match[]          @relation("MatchUser1")
  matchesAsUser2  Match[]          @relation("MatchUser2")
  posts           Post[]
  savedPosts      PostSave[]
  stories         Story[]
  chatsAsUser1    Chat[]           @relation("ChatUser1")
  chatsAsUser2    Chat[]           @relation("ChatUser2")
  messages        Message[]
  roomMemberships RoomMembership[]
  confessions     Confession[]
  notifications   Notification[]
  mediaFiles      Media[]
  
  reportsCreated  Report[]         @relation("ReporterUser")
  reportsAbout    Report[]         @relation("ReportedUser")
  bans            Ban[]
  violations      UserViolation[]
  refreshTokens   RefreshToken[]
  postLikes       PostLike[]
  comments        Comment[]
  storyViews      StoryView[]
  readReceipts    MessageReadReceipt[]

  @@map("users")
}

model Profile {
  id          String    @id @default(uuid())
  userId      String    @unique
  username    String    @unique
  bio         String?
  birthDate   DateTime
  gender      Gender
  avatarUrl   String?
  bannerUrl   String?
  location    String?
  latitude    Float?
  longitude   Float?
  interests   String[]
  lookingFor  String[]
  minAge      Int       @default(18)
  maxAge      Int       @default(35)
  maxDistance Int       @default(50)
  isPrivate   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model UserStat {
  userId             String   @id
  followerCount      Int      @default(0)
  followingCount     Int      @default(0)
  postsCount         Int      @default(0)
  matchCount         Int      @default(0)
  storiesCount       Int      @default(0)
  averageEngagementRate Float @default(0.0)
  lastUpdated        DateTime @default(now())

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model UserFollow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@map("user_follows")
}

model UserVerification {
  id             String             @id @default(uuid())
  userId         String             @unique
  status         VerificationStatus @default(PENDING)
  selfieUrl      String
  idDocumentUrl  String?
  submittedAt    DateTime           @default(now())
  verifiedAt     DateTime?
  approvedBy     String?
  rejectionReason String?

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_verifications")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model MatchRequest {
  id          String      @id @default(uuid())
  senderId    String
  receiverId  String
  status      MatchStatus @default(PENDING)
  message     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  sender      User        @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User        @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@map("match_requests")
}

model Match {
  id        String   @id @default(uuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())

  user1     User     @relation("MatchUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User     @relation("MatchUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  chat      Chat?

  @@unique([user1Id, user2Id])
  @@map("matches")
}

model Post {
  id          String     @id @default(uuid())
  authorId    String
  caption     String?
  mediaUrls   String[]
  mediaTypes  MediaType[]
  isPublic    Boolean    @default(true)
  isDeleted   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes       PostLike[]
  comments    Comment[]
  saves       PostSave[]

  @@map("posts")
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

model PostSave {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("post_saves")
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Story {
  id         String      @id @default(uuid())
  authorId   String
  mediaUrl   String
  mediaType  MediaType
  caption    String?
  expiresAt  DateTime
  isDeleted  Boolean     @default(false)
  createdAt  DateTime    @default(now())

  author     User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views      StoryView[]

  @@map("stories")
}

model StoryView {
  id        String   @id @default(uuid())
  storyId   String
  viewerId  String
  viewedAt  DateTime @default(now())

  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer    User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@map("story_views")
}

model Chat {
  id                String    @id @default(uuid())
  matchId           String    @unique
  user1Id           String
  user2Id           String
  lastMessageId     String?
  lastMessageAt     DateTime?
  lastMessageContent String?
  unreadCount       Int       @default(0)
  mutedBy1          Boolean   @default(false)
  mutedBy2          Boolean   @default(false)
  archivedBy1       Boolean   @default(false)
  archivedBy2       Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  match             Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user1             User      @relation("ChatUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2             User      @relation("ChatUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages          Message[]

  @@map("chats")
}

model Message {
  id          String      @id @default(uuid())
  chatId      String
  senderId    String
  type        MessageType @default(TEXT)
  content     String?
  mediaUrl    String?
  isRead      Boolean     @default(false)
  deliveredAt DateTime?
  isDeleted   Boolean     @default(false)
  createdAt   DateTime    @default(now())

  chat        Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender      User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  readReceipts MessageReadReceipt[]

  @@map("messages")
}

model MessageReadReceipt {
  messageId     String
  readByUserId  String
  readAt        DateTime @default(now())

  message       Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [readByUserId], references: [id], onDelete: Cascade)

  @@id([messageId, readByUserId])
  @@map("message_read_receipts")
}

model Room {
  id          String           @id @default(uuid())
  name        String
  description String?
  type        RoomType         @default(PUBLIC)
  topic       String?
  avatarUrl   String?
  maxMembers  Int              @default(100)
  createdBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  memberships RoomMembership[]

  @@map("rooms")
}

model RoomMembership {
  id       String   @id @default(uuid())
  roomId   String
  userId   String
  isAdmin  Boolean  @default(false)
  joinedAt DateTime @default(now())

  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@map("room_memberships")
}

model Confession {
  id          String    @id @default(uuid())
  authorId    String
  content     String
  isAnonymous Boolean   @default(true)
  isRevealed  Boolean   @default(false)
  isDeleted   Boolean   @default(false)
  revealedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("confessions")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  type       NotificationType
  title      String
  body       String
  data       Json?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Media {
  id           String    @id @default(uuid())
  uploaderId   String
  type         MediaType
  url          String
  thumbnailUrl String?
  size         Int
  mimeType     String
  publicId     String?
  createdAt    DateTime  @default(now())

  uploader     User      @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@map("media")
}

model Report {
  id                       String       @id @default(uuid())
  contentId                String
  contentType              ContentType
  reporterId               String
  reportedId               String?
  reason                   ReportReason
  description              String?
  status                   ReportStatus @default(PENDING)
  resolution               ReportResolution?
  moderatorId              String?
  moderatorNotes           String?
  autoModerationStatus     String?
  autoModerationConfidence Float?
  resolvedAt               DateTime?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  reporter                 User         @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)
  reported                 User?        @relation("ReportedUser", fields: [reportedId], references: [id], onDelete: SetNull)

  @@index([status, contentType, createdAt(sort: Desc)])
  @@map("reports")
}

model AutoFlag {
  id          String       @id @default(uuid())
  contentId   String
  contentType ContentType
  flagType    AutoFlagType
  confidence  Float
  details     Json?
  autoAction  AutoAction
  status      FlagStatus   @default(QUEUED_FOR_REVIEW)
  createdAt   DateTime     @default(now())

  @@map("auto_flags")
}

model UserViolation {
  id           String    @id @default(uuid())
  userId       String
  reportId     String
  strikeNumber Int
  banDuration  String?
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_violations")
}

model Ban {
  id          String    @id @default(uuid())
  userId      String
  reason      String
  type        BanType
  expiresAt   DateTime?
  bannedBy    String
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bans")
}
