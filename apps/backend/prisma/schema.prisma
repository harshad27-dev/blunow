generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                  @id @default(uuid())
  email                    String                  @unique
  passwordHash             String?
  googleId                 String?                 @unique
  role                     Role                    @default(USER)
  isActive                 Boolean                 @default(true)
  isVerified               Boolean                 @default(false)
  fcmToken                 String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  banExpiresAt             DateTime?
  banStatus                BanStatus               @default(NONE)
  sexuality                Sexuality               @default(STRAIGHT)
  strikeCount              Int                     @default(0)
  bans                     Ban[]
  chatsAsUser1             Chat[]                  @relation("ChatUser1")
  chatsAsUser2             Chat[]                  @relation("ChatUser2")
  comments                 Comment[]
  commentLikes             CommentLike[]
  confessions              Confession[]
  receivedRequests         MatchRequest[]          @relation("ReceivedRequests")
  sentRequests             MatchRequest[]          @relation("SentRequests")
  dismissedRecommendations MatchDismissal[]        @relation("DismissedRecommendations")
  dismissedByUsers         MatchDismissal[]        @relation("DismissedByUsers")
  matchesAsUser1           Match[]                 @relation("MatchUser1")
  matchesAsUser2           Match[]                 @relation("MatchUser2")
  mediaFiles               Media[]
  readReceipts             MessageReadReceipt[]
  messages                 Message[]
  notifications            Notification[]
  notificationPreference   NotificationPreference?
  privacyPreference        UserPrivacyPreference?
  blockedUsers             UserBlock[]             @relation("UserBlocker")
  blockedByUsers           UserBlock[]             @relation("UserBlocked")
  postLikes                PostLike[]
  savedPosts               PostSave[]
  posts                    Post[]
  profile                  Profile?
  refreshTokens            RefreshToken[]
  reportsAbout             Report[]                @relation("ReportedUser")
  reportsCreated           Report[]                @relation("ReporterUser")
  roomMemberships          RoomMembership[]
  stories                  Story[]
  storyViews               StoryView[]
  following                UserFollow[]            @relation("UserFollowing")
  followers                UserFollow[]            @relation("UserFollowers")
  stats                    UserStat?
  verification             UserVerification?
  violations               UserViolation[]
  profileViewsMade         ProfileView[]           @relation("ProfileViewViewer")
  profileViewsReceived     ProfileView[]           @relation("ProfileViewTarget")

  @@map("users")
}

model Profile {
  id               String   @id @default(uuid())
  userId           String   @unique
  name             String?
  username         String   @unique
  bio              String?
  birthDate        DateTime
  gender           Gender
  avatarUrl        String?
  profilePhotoUrls String[] @default([])
  location         String?
  latitude         Float?
  longitude        Float?
  interests        String[]
  interestedIn     String[]
  lookingFor       String[]
  relationship     String?
  drinking         String?
  smoking          String?
  workout          String?
  pets             String?
  zodiac           String?
  minAge           Int      @default(18)
  maxAge           Int      @default(35)
  maxDistance      Int      @default(50)
  isPrivate        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model UserStat {
  userId                String   @id
  followerCount         Int      @default(0)
  followingCount        Int      @default(0)
  postsCount            Int      @default(0)
  matchCount            Int      @default(0)
  storiesCount          Int      @default(0)
  profileViews          Int      @default(0)
  averageEngagementRate Float    @default(0.0)
  lastUpdated           DateTime @default(now())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model ProfileView {
  id           String   @id @default(uuid())
  viewerId     String
  viewedUserId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  viewer       User     @relation("ProfileViewViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  viewedUser   User     @relation("ProfileViewTarget", fields: [viewedUserId], references: [id], onDelete: Cascade)

  @@unique([viewerId, viewedUserId])
  @@index([viewedUserId, createdAt])
  @@map("profile_views")
}

model UserFollow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@map("user_follows")
}

model UserVerification {
  id              String             @id @default(uuid())
  userId          String             @unique
  status          VerificationStatus @default(PENDING)
  selfieUrl       String
  idDocumentUrl   String?
  submittedAt     DateTime           @default(now())
  verifiedAt      DateTime?
  approvedBy      String?
  rejectionReason String?
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_verifications")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model LoginOtp {
  id        String   @id @default(uuid())
  email     String   @unique
  otpHash   String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("login_otps")
}

model MatchRequest {
  id         String      @id @default(uuid())
  senderId   String
  receiverId String
  status     MatchStatus @default(PENDING)
  message    String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  receiver   User        @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User        @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  chat       Chat?

  @@unique([senderId, receiverId])
  @@map("match_requests")
}

model Match {
  id        String   @id @default(uuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())
  chat      Chat?
  user1     User     @relation("MatchUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User     @relation("MatchUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@map("matches")
}

model MatchDismissal {
  id              String   @id @default(uuid())
  userId          String
  dismissedUserId String
  createdAt       DateTime @default(now())
  dismissedUser   User     @relation("DismissedByUsers", fields: [dismissedUserId], references: [id], onDelete: Cascade)
  user            User     @relation("DismissedRecommendations", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dismissedUserId])
  @@index([userId, createdAt])
  @@map("match_dismissals")
}

model Post {
  id          String      @id @default(uuid())
  authorId    String
  caption     String?
  mediaUrls   String[]
  mediaTypes  MediaType[]
  isPublic    Boolean     @default(true)
  isAnonymous Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  isDeleted   Boolean     @default(false)
  comments    Comment[]
  likes       PostLike[]
  saves       PostSave[]
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("posts")
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

model PostSave {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("post_saves")
}

model Comment {
  id        String        @id @default(uuid())
  postId    String
  authorId  String
  parentId  String?
  content   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes     CommentLike[]
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")

  @@map("comments")
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_likes")
}

model Story {
  id        String      @id @default(uuid())
  authorId  String
  mediaUrl  String
  mediaType MediaType
  caption   String?
  expiresAt DateTime
  createdAt DateTime    @default(now())
  isDeleted Boolean     @default(false)
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views     StoryView[]

  @@map("stories")
}

model StoryView {
  id       String   @id @default(uuid())
  storyId  String
  viewerId String
  viewedAt DateTime @default(now())
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer   User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@map("story_views")
}

model Chat {
  id                 String        @id @default(uuid())
  matchId            String?       @unique
  requestId          String?       @unique
  user1Id            String
  user2Id            String
  requestedById      String?
  status             ChatStatus    @default(ACTIVE)
  createdAt          DateTime      @default(now())
  archivedBy1        Boolean       @default(false)
  archivedBy2        Boolean       @default(false)
  deletedBy1         Boolean       @default(false)
  deletedBy2         Boolean       @default(false)
  lastMessageAt      DateTime?
  lastMessageContent String?
  lastMessageId      String?
  mutedBy1           Boolean       @default(false)
  mutedBy2           Boolean       @default(false)
  unreadCount        Int           @default(0)
  updatedAt          DateTime      @updatedAt
  match              Match?        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  request            MatchRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  user1              User          @relation("ChatUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2              User          @relation("ChatUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages           Message[]

  @@index([status, requestedById])
  @@map("chats")
}

model Message {
  id                   String               @id @default(uuid())
  chatId               String
  senderId             String
  type                 MessageType          @default(TEXT)
  content              String?
  mediaUrl             String?
  isRead               Boolean              @default(false)
  createdAt            DateTime             @default(now())
  deliveredAt          DateTime?
  isDeleted            Boolean              @default(false)
  replyToMessageId     String?
  storyId              String?
  storyPreviewMediaUrl String?
  storyPreviewCaption  String?
  storyAuthorId        String?
  postId               String?
  postPreviewMediaUrl  String?
  postPreviewCaption   String?
  postAuthorName       String?
  readReceipts         MessageReadReceipt[]
  chat                 Chat                 @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender               User                 @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyToMessage       Message?             @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies              Message[]            @relation("MessageReplies")

  @@index([replyToMessageId])
  @@index([postId])
  @@map("messages")
}

model MessageReadReceipt {
  messageId    String
  readByUserId String
  readAt       DateTime @default(now())
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [readByUserId], references: [id], onDelete: Cascade)

  @@id([messageId, readByUserId])
  @@map("message_read_receipts")
}

model Room {
  id          String           @id @default(uuid())
  name        String
  description String?
  type        RoomType         @default(PUBLIC)
  topic       String?
  avatarUrl   String?
  maxMembers  Int              @default(100)
  createdBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  memberships RoomMembership[]

  @@map("rooms")
}

model RoomMembership {
  id       String   @id @default(uuid())
  roomId   String
  userId   String
  isAdmin  Boolean  @default(false)
  joinedAt DateTime @default(now())
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@map("room_memberships")
}

model Confession {
  id          String    @id @default(uuid())
  authorId    String
  content     String
  isAnonymous Boolean   @default(true)
  isRevealed  Boolean   @default(false)
  revealedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isDeleted   Boolean   @default(false)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("confessions")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model NotificationPreference {
  userId      String   @id
  pushEnabled Boolean  @default(true)
  matches     Boolean  @default(true)
  messages    Boolean  @default(true)
  likes       Boolean  @default(true)
  comments    Boolean  @default(true)
  storyViews  Boolean  @default(true)
  confessions Boolean  @default(true)
  roomInvites Boolean  @default(true)
  system      Boolean  @default(true)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt   DateTime @updatedAt

  @@map("notification_preferences")
}

model UserPrivacyPreference {
  userId           String   @id
  discoverable     Boolean  @default(true)
  showOnlineStatus Boolean  @default(true)
  readReceipts     Boolean  @default(true)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt        DateTime @updatedAt

  @@map("user_privacy_preferences")
}

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("UserBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("UserBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model Media {
  id           String    @id @default(uuid())
  uploaderId   String
  type         MediaType
  url          String
  thumbnailUrl String?
  size         Int
  mimeType     String
  publicId     String?
  createdAt    DateTime  @default(now())
  uploader     User      @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@map("media")
}

model Report {
  id                       String            @id @default(uuid())
  reporterId               String
  reportedId               String?
  reason                   ReportReason
  description              String?
  status                   ReportStatus      @default(PENDING)
  resolvedAt               DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  autoModerationConfidence Float?
  autoModerationStatus     String?
  contentId                String
  contentType              ContentType
  moderatorId              String?
  moderatorNotes           String?
  resolution               ReportResolution?
  reported                 User?             @relation("ReportedUser", fields: [reportedId], references: [id])
  reporter                 User              @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, contentType, createdAt(sort: Desc)])
  @@map("reports")
}

model AutoFlag {
  id          String       @id @default(uuid())
  contentId   String
  contentType ContentType
  flagType    AutoFlagType
  confidence  Float
  details     Json?
  autoAction  AutoAction
  status      FlagStatus   @default(QUEUED_FOR_REVIEW)
  createdAt   DateTime     @default(now())

  @@map("auto_flags")
}

model UserViolation {
  id           String   @id @default(uuid())
  userId       String
  reportId     String
  strikeNumber Int
  banDuration  String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_violations")
}

model Ban {
  id        String    @id @default(uuid())
  userId    String
  reason    String
  type      BanType
  expiresAt DateTime?
  bannedBy  String
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bans")
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  OTHER
}

enum Sexuality {
  STRAIGHT
  GAY
  LESBIAN
  BI
  ASEXUAL
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ChatStatus {
  REQUESTED
  ACTIVE
  REJECTED
}

enum MessageType {
  TEXT
  STORY_REPLY
  IMAGE
  VIDEO
  AUDIO
  GIF
  POST
}

enum RoomType {
  PUBLIC
  PRIVATE
  TOPIC
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum NotificationType {
  MATCH
  MESSAGE
  LIKE
  COMMENT
  STORY_VIEW
  CONFESSION
  ROOM_INVITE
  SYSTEM
}

enum BanType {
  TEMPORARY
  PERMANENT
}

enum BanStatus {
  NONE
  WARNED
  TEMP_BANNED
  PERM_BANNED
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
  PENDING
  ESCALATED
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE_CONTENT
  FAKE_PROFILE
  HATE_SPEECH
  OTHER
}

enum ContentType {
  POST
  COMMENT
  STORY
  MESSAGE
  CONFESSION
  USER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AutoFlagType {
  NUDITY
  VIOLENCE
  TOXICITY
  SPAM
  EXPLICIT
}

enum AutoAction {
  HOLD_FOR_REVIEW
  AUTO_REMOVE
}

enum ReportResolution {
  APPROVED
  REJECTED
  DISMISSED
}

enum FlagStatus {
  QUEUED_FOR_REVIEW
  AUTO_REMOVED
}
