{
  "expo": {
    "name": "Datebl",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.datebl.mobile",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0F0E0D",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#0F0E0D"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.datebl.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#0F0E0D"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "Datebl uses your photo library so you can choose photos for stories.",
          "savePhotosPermission": "Datebl can save photos you capture for stories to your library.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Datebl uses your location during signup to help show nearby people and rooms."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}


